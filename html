<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Arrow Escape</title>
<style>
:root{--bg:#e6eee8;--ink:#14262b;--card:#fbfdf9;--ac:#14262b;--teal:#0f8b8d;--warn:#e4572e;--gold:#f2b134}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--ink);font-family:ui-rounded,"Trebuchet MS",system-ui,sans-serif;display:flex;flex-direction:column;align-items:center;padding:env(safe-area-inset-top,0) 12px env(safe-area-inset-bottom,0);transition:background .6s}
header{width:100%;max-width:560px;display:flex;justify-content:space-between;align-items:center;padding:12px 4px;font-weight:700;font-size:15px;gap:6px}
header span{display:flex;gap:6px;align-items:center}
button{font:inherit;cursor:pointer}
.btn{background:var(--ink);color:#fff;border:0;border-radius:14px;padding:13px 18px;font-weight:700;font-size:16px}
.btn.alt{background:#fff;color:var(--ink);border:2px solid var(--ink)}
.btn.gold{background:var(--gold);color:var(--ink)}
.btn:disabled{opacity:.4}
#board{position:relative;width:min(94vw,560px,calc(100vh - 170px));aspect-ratio:1;background:var(--card);border-radius:18px;border:2px solid var(--ink);background-image:radial-gradient(circle,#b9c6bd 1.5px,transparent 2px);background-size:calc(100%/var(--n)) calc(100%/var(--n));overflow:hidden;touch-action:manipulation}
.a{position:absolute;border:0;background:none;padding:0;display:flex;align-items:center;justify-content:center;color:var(--ac);transition:transform .35s cubic-bezier(.5,0,.9,.5),opacity .35s}
.a svg{width:88%;height:88%;display:block}
.a.out{opacity:0}
.a.bump{animation:bump .3s}
.a.hint{animation:pulse .5s 3;color:var(--teal)}
.v,.rk{position:absolute;scale:.86;border-radius:8px}
.v{background:#c9d6cd;opacity:.6}
.rk{background:#6b7b73;border:3px solid #46564f}
.pop{position:absolute;font-weight:800;font-size:20px;color:var(--warn);pointer-events:none;animation:fl .8s forwards;text-shadow:0 1px #fff}
@keyframes fl{to{translate:0 -46px;opacity:0}}
@keyframes bump{25%{translate:-6px 0;color:var(--warn)}75%{translate:6px 0;color:var(--warn)}}
@keyframes pulse{50%{scale:1.3}}
footer{display:flex;gap:10px;margin-top:16px}
#ov{position:fixed;inset:0;background:rgba(20,38,43,.55);display:flex;align-items:center;justify-content:center;padding:20px}
#ov[hidden]{display:none}
.card{background:var(--card);border-radius:20px;border:2px solid var(--ink);padding:22px;width:100%;max-width:380px;display:flex;flex-direction:column;gap:10px;max-height:88vh;overflow:auto}
.card h2{margin:0 0 4px;font-size:24px}
.card p{margin:0;line-height:1.4}
.row{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid #d5ded7}
.sw{width:26px;height:26px;border-radius:8px;display:inline-block;vertical-align:middle;margin-right:8px}
button:focus-visible{outline:3px solid var(--teal);outline-offset:2px}
@media (prefers-reduced-motion:reduce){.a,.a.bump,.a.hint,.pop{animation:none;transition:none}}
</style>
</head>
<body>
<header>
  <button class="btn alt" id="menu" style="padding:8px 12px">Menu</button>
  <span><span id="lvl"></span><b id="tm" style="background:#14262b;color:#fff;border-radius:10px;padding:3px 8px">0:00</b></span>
  <span><b id="lives"></b><b id="coins"></b></span>
</header>
<div id="board" style="--n:4"></div>
<footer>
  <button class="btn" id="hint">Hint</button>
  <button class="btn alt" id="restart">Restart</button>
</footer>
<div id="ov" hidden></div>

<script>
const $=s=>document.querySelector(s);
const DIR=[[0,-1],[1,0],[0,1],[-1,0]];
const MAXL=2000;
const SKINS=[{n:'Ink',c:'#14262b',p:0},{n:'Lagoon',c:'#0f8b8d',p:100},{n:'Mango',c:'#f2a000',p:200},{n:'Berry',c:'#9b2c6a',p:300},{n:'Cobalt',c:'#2748d8',p:400},{n:'Ruby',c:'#c0182f',p:600},{n:'Aurora',c:'#7a3cff',p:800}];
/* Maps: a function that returns 1 for a "void" cell (no arrows there). */
const MAPS=[['Classic',()=>0],
['Diamond',(x,y,n)=>Math.abs(x-(n-1)/2)+Math.abs(y-(n-1)/2)>n*.7],
['Ring',(x,y,n)=>Math.max(Math.abs(x-(n-1)/2),Math.abs(y-(n-1)/2))<n*.17],
['Cross',(x,y,n)=>{const c=(n-1)/2,k=n*.2;return Math.abs(x-c)>k&&Math.abs(y-c)>k}],
['Checker',(x,y)=>x%3==1&&y%3==1],
['Circle',(x,y,n)=>Math.hypot(x-(n-1)/2,y-(n-1)/2)>n*.52],
['Hourglass',(x,y,n)=>{const c=(n-1)/2;return Math.abs(x-c)>Math.abs(y-c)*1.4+1}]];
const HINT_PRICE=30;
/* ===== ADS: put your AdSense publisher ID in client (leave '' for demo ads) =====
   test:true = Google test ads. every = full-screen ad after every Nth level (only after level 20). */
const ADS={client:'',test:true,every:3};
let wins=0;
if(ADS.client){
  window.adsbygoogle=window.adsbygoogle||[];
  window.adBreak=window.adConfig=o=>window.adsbygoogle.push(o);
  const sc=document.createElement('script');
  sc.async=true;sc.crossOrigin='anonymous';
  sc.src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client='+ADS.client;
  if(ADS.test)sc.dataset.adbreakTest='on';
  document.head.appendChild(sc);
  window.adConfig({preloadAdBreaks:'on',sound:'on'});
}
let S=Object.assign({lvl:1,coins:0,hints:2,skin:0,own:[0],daily:{},best:{},stars:{},streak:0,last:'',snd:1,name:''},(()=>{try{return JSON.parse(localStorage.getItem('arrowEscape')||'{}')}catch(e){return{}}})());
const save=()=>{try{localStorage.setItem('arrowEscape',JSON.stringify(S))}catch(e){}};
const today=()=>new Date().toISOString().slice(0,10);
const hash=s=>[...s].reduce((h,c)=>(h*31+c.charCodeAt(0))|0,7);
function rng(a){return()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
let AC;
function snd(f,d=.09){if(!S.snd)return;try{AC=AC||new AudioContext();const o=AC.createOscillator(),g=AC.createGain();o.frequency.value=f;g.gain.value=.05;o.connect(g);g.connect(AC.destination);o.start();g.gain.exponentialRampToValueAtTime(.001,AC.currentTime+d);o.stop(AC.currentTime+d)}catch(e){}}
const vib=p=>{try{S.snd&&navigator.vibrate&&navigator.vibrate(p)}catch(e){}};

/* Level generator (reverse removal order -> always solvable). Rocks never move and block paths;
   map shapes leave void cells. Difficulty rises to level 2000: bigger grids, denser boards,
   longer blocking chains and more rocks. */
function gen(seed,lvl){
  const R=rng(seed),prog=lvl/MAXL;
  const n=lvl<=2?4:lvl<=6?5:Math.min(9,5+Math.floor(Math.sqrt(lvl)/3.5));
  const mi=lvl<=6?0:lvl%MAPS.length;
  const fill=lvl<=2?.3:lvl<=6?.4+.04*(lvl-3):Math.min(.9,.52+.38*Math.sqrt(prog));
  const chain=lvl<=2?.4:Math.min(.98,.6+lvl/250);
  const voids=new Set(),W=new Set();
  for(let x=0;x<n;x++)for(let y=0;y<n;y++)if(MAPS[mi][1](x,y,n))voids.add(x+','+y);
  const rocks=lvl<30?0:Math.min(Math.floor(n*n*.15),Math.floor(lvl/50));
  for(let i=0;i<rocks*20&&W.size<rocks;i++){const k=Math.floor(R()*n)+','+Math.floor(R()*n);if(!voids.has(k))W.add(k)}
  const target=Math.round((n*n-voids.size-W.size)*fill);
  const occ=new Set(W),pc=new Map(),arrows=[];
  const pathOf=(x,y,d)=>{const p=[];let cx=x+DIR[d][0],cy=y+DIR[d][1];while(cx>=0&&cy>=0&&cx<n&&cy<n){p.push(cx+','+cy);cx+=DIR[d][0];cy+=DIR[d][1]}return p};
  for(let i=0;i<60000&&arrows.length<target;i++){
    let best=null;
    for(let t=0;t<(R()<chain?8:1);t++){
      const x=Math.floor(R()*n),y=Math.floor(R()*n),k=x+','+y;
      if(occ.has(k)||voids.has(k))continue;
      const opts=[0,1,2,3].map(d=>({d,path:pathOf(x,y,d)})).filter(o=>!o.path.some(c=>occ.has(c)));
      if(!opts.length)continue;
      const score=pc.get(k)||0;
      if(!best||score>best.score)best={x,y,k,score,opts};
    }
    if(!best)continue;
    const o=R()<chain?best.opts.reduce((m,q)=>q.path.length>m.path.length?q:m):best.opts[Math.floor(R()*best.opts.length)];
    arrows.push({x:best.x,y:best.y,d:o.d,path:o.path});occ.add(best.k);
    o.path.forEach(c=>pc.set(c,(pc.get(c)||0)+1));
  }
  return{n,arrows,voids,W,mi};
}

let G,mode,lives,live,over,finale,el=0,lastT=Date.now(),combo=0,maxc=0;
const fmt=s=>Math.floor(s/60)+':'+String(Math.floor(s%60)).padStart(2,'0');
setInterval(()=>{const n=Date.now();if(G&&!over&&$ov.hidden)el+=(n-lastT)/1000;lastT=n;const t=$('#tm');if(t)t.textContent=fmt(el)},250);
const $ov=$('#ov');
function show(html){$ov.innerHTML='<div class="card">'+html+'</div>';$ov.hidden=false}
function hide(){$ov.hidden=true}
const blocked=a=>a.path.some(c=>live.has(c)||G.W.has(c));
function hud(){
  $('#lvl').textContent=(mode==='daily'?'Daily':'Lv '+S.lvl)+' · '+MAPS[G.mi][0];
  $('#lives').textContent='♥'.repeat(lives)+'♡'.repeat(Math.max(0,3-lives))+' ';
  $('#coins').textContent='● '+S.coins;
  $('#hint').textContent='Hint ('+S.hints+')';
  const st=document.body.style;
  st.setProperty('--ac',SKINS[S.skin].c);
  st.setProperty('--bg','hsl('+((Math.floor((S.lvl-1)/50)*53+140)%360)+' 28% 91%)');
}
function start(m){
  mode=m;over=false;
  const lvl=m==='daily'?40+Math.abs(hash(today()))%160:S.lvl, seed=m==='daily'?hash(today()):lvl*7919+13;
  G=gen(seed,lvl);lives=3;el=0;lastT=Date.now();live=new Map();combo=maxc=0;
  const bd=$('#board');bd.innerHTML='';bd.style.setProperty('--n',G.n);
  const pos=(b,x,y)=>b.style.cssText=`left:${x*100/G.n}%;top:${y*100/G.n}%;width:${100/G.n}%;height:${100/G.n}%`;
  const tile=(c,k)=>{const [x,y]=k.split(',').map(Number),d=document.createElement('div');d.className=c;pos(d,x,y);bd.appendChild(d)};
  G.voids.forEach(k=>tile('v',k));G.W.forEach(k=>tile('rk',k));
  G.arrows.forEach(a=>{
    live.set(a.x+','+a.y,a);
    const b=document.createElement('button');b.className='a';
    b.setAttribute('aria-label','Arrow '+['up','right','down','left'][a.d]);
    pos(b,a.x,a.y);
    b.innerHTML=`<svg viewBox="0 0 24 24" style="transform:rotate(${a.d*90}deg)"><path fill="currentColor" d="M12 2 21 13h-6v9H9v-9H3z"/></svg>`;
    b.onclick=()=>tap(a);a.el=b;bd.appendChild(b);
  });
  hud();hide();
}
function pop(a,t){const p=document.createElement('div');p.className='pop';p.textContent=t;p.style.left=a.x*100/G.n+'%';p.style.top=a.y*100/G.n+'%';$('#board').appendChild(p);setTimeout(()=>p.remove(),800)}
function tap(a){
  if(over||a.gone)return;
  if(blocked(a)){
    a.el.classList.remove('bump');void a.el.offsetWidth;a.el.classList.add('bump');
    combo=0;snd(120,.18);vib(60);lives--;hud();
    if(lives<=0){over=true;setTimeout(lose,350)}
    return;
  }
  a.gone=true;live.delete(a.x+','+a.y);
  combo++;maxc=Math.max(maxc,combo);snd(380+Math.min(combo,20)*35);
  if(combo>=3)pop(a,'x'+combo);
  const [dx,dy]=DIR[a.d],n=G.n;
  const dist=a.d===0?a.y+1:a.d===2?n-a.y:a.d===3?a.x+1:n-a.x;
  a.el.classList.add('out');
  a.el.style.transform=`translate(${dx*dist*100}%,${dy*dist*100}%)`;
  setTimeout(()=>a.el.remove(),400);
  if(!live.size){over=true;setTimeout(win,450)}
}
function win(){
  finale=false;const secs=Math.round(el),st=Math.max(1,lives);
  let gain=10+G.n+st*2+Math.floor(maxc/5),msg;
  snd(660,.12);setTimeout(()=>snd(880,.2),130);vib([40,40,80]);
  if(mode==='daily'){
    const first=!(today() in S.daily),prev=S.daily[today()];gain=first?gain*2:0;
    if(first||secs<prev)S.daily[today()]=secs;
    msg=`Daily solved in ${fmt(secs)}.`+(first?'':` Best today: ${fmt(Math.min(prev,secs))}. Coins are paid once per day.`);
  }else{
    const k=S.lvl,prev=S.best[k],isBest=prev===undefined||secs<prev;if(isBest)S.best[k]=secs;
    S.stars[k]=Math.max(S.stars[k]||0,st);
    msg=`Level ${k} solved in ${fmt(secs)}. `+(prev===undefined?'First clear!':isBest?`New best! (was ${fmt(prev)})`:`Your best: ${fmt(prev)}`);
    finale=S.lvl>=MAXL;S.lvl=Math.min(MAXL,S.lvl+1);if(finale)msg='You cleared all 2,000 levels! Last time: '+fmt(secs)
  }
  S.coins+=gain;save();hud();sync();
  show(`<h2>${'★'.repeat(st)}${'☆'.repeat(3-st)}</h2><p><b>${finale?'All levels cleared':'Path clear'}</b><br>${msg}<br>Best combo x${maxc} · +${gain} coins${st<3?'<br>Clear with no mistakes for 3 stars.':''}</p>
  ${gain>0?`<button class="btn gold" onclick="dbl(${gain})">Watch ad: double coins (+${gain})</button>`:''}
  <button class="btn" onclick="nextLevel()">${mode==='daily'?'Back to levels':'Next level'}</button><button class="btn alt" onclick="menu()">Menu</button>`);
}
function lose(){
  show(`<h2>Out of lives</h2><p>Every blocked tap costs a life. Look for arrows whose path to the edge is empty. Gray blocks never move.</p>
  <button class="btn gold" onclick="ad(()=>{lives=1;over=false;hud();hide()})">Watch ad: continue with 1 life</button>
  <button class="btn" onclick="start('${mode}')">Retry</button><button class="btn alt" onclick="menu()">Menu</button>`);
}
function useHint(){
  if(over)return;
  if(S.hints<1){
    show(`<h2>No hints left</h2><p>A hint highlights an arrow you can safely tap.</p>
    <button class="btn gold" onclick="ad(()=>{S.hints++;save();hud();hide()})">Watch ad: get 1 hint</button>
    <button class="btn" ${S.coins<HINT_PRICE?'disabled':''} onclick="S.coins-=${HINT_PRICE};S.hints++;save();hud();hide()">Buy for ${HINT_PRICE} coins</button>
    <button class="btn alt" onclick="hide()">Close</button>`);return;
  }
  const a=G.arrows.find(a=>!a.gone&&!blocked(a));
  if(a){S.hints--;save();hud();a.el.classList.add('hint');setTimeout(()=>a.el.classList.remove('hint'),1600)}
}
function ad(cb){
  if(!ADS.client||typeof adBreak!=='function')return demoAd(cb);
  let viewed=false;
  adBreak({type:'reward',name:'reward',
    beforeReward:showAd=>showAd(),
    adViewed:()=>{viewed=true},
    adBreakDone:()=>{
      if(viewed)cb();
      else show('<h2>No reward</h2><p>No ad was available, or it was closed early. Try again in a moment.</p><button class="btn" onclick="menu()">Menu</button>');
    }});
}
function nextLevel(){
  wins++;
  if(ADS.client&&typeof adBreak==='function'&&S.lvl>20&&wins%ADS.every===0){
    hide();adBreak({type:'next',name:'next-level',adBreakDone:()=>start('lvl')});
  }else start('lvl');
}
function dbl(g){
  ad(()=>{S.coins+=g;save();hud();show(`<h2>Coins doubled</h2><p>+${g} bonus coins.</p><button class="btn" onclick="nextLevel()">Next level</button>`)});
}
function demoAd(cb){
  let s=3;show(`<h2>Ad</h2><p id="adt">Reward in ${s}s (demo ad, replace with a real network)</p>`);
  const t=setInterval(()=>{s--;if(s<=0){clearInterval(t);cb()}else $('#adt').textContent=`Reward in ${s}s (demo ad, replace with a real network)`},1000);
}
const totStars=()=>Object.values(S.stars).reduce((a,b)=>a+b,0);
function menu(){
  const done=today() in S.daily;
  show(`<h2>Arrow Escape</h2><p>Tap an arrow to slide it off the board. A blocked arrow costs a life. Chain clean taps for combos.</p>
  <p>🔥 Day streak: <b>${S.streak}</b> · ★ <b>${totStars()}</b> · World <b>${Math.floor((S.lvl-1)/50)+1}</b></p>
  <button class="btn" onclick="start('lvl')">Play level ${S.lvl} / ${MAXL}</button>
  <button class="btn gold" onclick="start('daily')">Daily challenge${done?' (done, beat your time)':''}</button>
  <button class="btn alt" onclick="skins()">Skins</button>
  <button class="btn alt" onclick="board()">Leaderboard</button>
  <button class="btn alt" onclick="S.snd=S.snd?0:1;save();menu()">Sound & vibration: ${S.snd?'On':'Off'}</button>
  ${G?'<button class="btn alt" onclick="hide()">Resume</button>':''}`);
}
function skins(){
  show('<h2>Skins</h2>'+SKINS.map((s,i)=>{
    const own=S.own.includes(i);
    return `<div class="row"><span><i class="sw" style="background:${s.c}"></i>${s.n}</span>
    <button class="btn ${S.skin===i?'':'alt'}" style="padding:8px 12px" ${!own&&S.coins<s.p?'disabled':''} onclick="pick(${i})">${S.skin===i?'Equipped':own?'Equip':'● '+s.p}</button></div>`}).join('')+
    '<button class="btn alt" onclick="menu()">Back</button>');
}
function pick(i){
  if(!S.own.includes(i)){S.coins-=SKINS[i].p;S.own.push(i)}
  S.skin=i;save();hud();skins();
}
/* Local leaderboard (this device only). For a global one, send scores to a backend such as Firebase. */
function mine(){
  const days=Object.entries(S.daily).sort((a,b)=>a[1]-b[1]).slice(0,7);
  show(`<h2>Leaderboard</h2><div class="row"><span>Highest level</span><b>${S.lvl}</b></div><div class="row"><span>Total stars</span><b>★ ${totStars()}</b></div>
  <p><b>Fastest daily clears</b></p>`+(days.length?days.map(([d,t])=>`<div class="row"><span>${d}</span><b>${fmt(t)}</b></div>`).join(''):'<p>Finish a daily challenge to set a time.</p>')+
  '<button class="btn alt" onclick="menu()">Back</button>');
}
/* ===== World leaderboard (shared db). Needs the page opened while signed in to Claude. ===== */
let DB=null,UID=null;
const esc=t=>String(t).replace(/[&<>"']/g,c=>'&#'+c.charCodeAt(0)+';');
const cleared=()=>Object.keys(S.best).length;
const totTime=()=>Object.values(S.best).reduce((a,b)=>a+b,0);
function sync(){
  if(!DB||!UID||!cleared())return;
  DB.collection('lb').doc(UID).set({cl:cleared(),t:totTime(),name:S.name||'Player',stars:totStars()}).catch(()=>{});
}
(async()=>{try{
  if(!window.claude||!claude.use)return;
  const u=await claude.use('user');DB=await claude.use('db');
  if(u&&DB){UID=await u.id();sync()}
}catch(e){}})();
function setName(){S.name=$('#nm').value.trim().slice(0,12);save();sync();board()}
async function board(){
  show(`<h2>World leaderboard</h2><p>Ranked by levels cleared, then by total time.</p><div id="wb"><p>Loading...</p></div>
  <div class="row"><input id="nm" maxlength="12" placeholder="Your nickname" value="${esc(S.name)}" style="flex:1;min-width:0;font:inherit;padding:8px;border:2px solid var(--ink);border-radius:10px"><button class="btn" style="padding:8px 12px" onclick="setName()">Save</button></div>
  <button class="btn alt" onclick="mine()">My records</button><button class="btn alt" onclick="menu()">Back</button>`);
  const w=$('#wb');
  if(!DB){w.innerHTML='<p>The world ranking is not available here. Open the game link while signed in to Claude to join it.</p>';return}
  try{
    const sn=await DB.collection('lb').orderBy('cl','desc').limit(50).get();
    const r=sn.docs.map(d=>Object.assign({id:d.id},d.data())).sort((a,b)=>b.cl-a.cl||a.t-b.t).slice(0,20);
    w.innerHTML=r.length?'<div class="row"><b>#  Player</b><b>Level · Time</b></div>'+r.map((x,i)=>`<div class="row" style="${x.id===UID?'background:#f2b13433;border-radius:8px;padding:8px 6px':''}"><span>${i+1}. ${esc(x.name||'Player')}${x.id===UID?' (you)':''}</span><b>Lv ${esc(x.cl)} · ${fmt(+x.t||0)}</b></div>`).join(''):'<p>No scores yet. Clear a level to be the first!</p>';
  }catch(e){w.innerHTML='<p>Could not load the ranking. Try again in a moment.</p>'}
}
$('#menu').onclick=menu;
$('#hint').onclick=useHint;
$('#restart').onclick=()=>start(mode);
start('lvl');
/* Daily login gift with streak bonus */
{const t=today(),y=new Date(Date.now()-864e5).toISOString().slice(0,10);
if(S.last!==t){S.streak=S.last===y?S.streak+1:1;const b=Math.min(50,10*S.streak);S.coins+=b;S.last=t;save();hud();
show(`<h2>Daily gift</h2><p>🔥 Day ${S.streak} streak! +${b} coins. Come back tomorrow for more.</p><button class="btn" onclick="hide()">Play</button>`)}}
</script>
</body>
</html>
